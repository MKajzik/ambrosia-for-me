                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "start_date": {
                    "description": "YYYY-MM-DD",
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "model.Ingredient": {
            "type": "object",
            "required": [
                "base_unit",
                "calories_per_100",
                "category",
                "name"
            ],
            "properties": {
                "base_unit": {
                    "type": "string",
                    "enum": [
                        "g",
                        "ml",
                        "pcs"
                    ]
                },
                "calories_per_100": {
                    "type": "number"
                },
                "carbs_per_100": {
                    "type": "number"
                },
                "category": {
                    "type": "string",
                    "enum": [
                        "Owoce",
                        "Warzywa",
                        "Mięso",
                        "Ryby",
                        "Nabiał",
                        "Pieczywo",
                        "Produkty zbożowe",
                        "Przyprawy",
                        "Napoje",
                        "Słodycze",
                        "Tłuszcze",
                        "Inne"
                    ]
                },
                "created_at": {
                    "type": "string"
                },
                "fat_per_100": {
                    "type": "number"
                },
                "fiber_per_100": {
                    "type": "number"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "package_size": {
                    "type": "number"
                },
                "protein_per_100": {
                    "type": "number"
                },
                "salt_per_100": {
                    "type": "number"
                },
                "saturated_fat_per_100": {
                    "type": "number"
                },
                "sugars_per_100": {
                    "type": "number"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "model.Meal": {
            "type": "object",
            "required": [
                "meal_type",
                "name"
            ],
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "ingredients": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.MealIngredient"
                    }
                },
                "instructions": {
