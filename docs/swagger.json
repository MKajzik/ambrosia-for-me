    "definitions": {
        "handler.mealPlanRequest": {
            "type": "object",
            "required": [
                "end_date",
                "name",
                "start_date"
            ],
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "end_date": {
                    "description": "YYYY-MM-DD",
                    "type": "string"
                },
                "entries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.MealPlanEntry"
                    }
